{
  "expo": {
    "name": "Trace",
    "slug": "trace",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alustudent.trace"
    },
    "android": {
      "package": "com.alustudent.trace",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Trace needs access to your photos to attach construction site images to reports.",
          "cameraPermission": "Trace needs your camera to photograph construction stages for AI verification."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1eaa69a5-b42b-4ca6-b9d5-1a325739e4a7"
      }
    }
  }
}
